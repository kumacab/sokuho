{
  "brand": {
    "name": "SOKUHŌ",
    "kanji": "速報",
    "handle": "@sokuho.fr",
    "tagline": "L'actu anime, manga & manhua en direct"
  },
  "use_official_visuals": true,
  "require_visual": true,
  "stories": true,
  "reel_per_post": false,
  "weekly_recap": {
    "enabled": true,
    "weekday": 7,
    "hour": 18,
    "reel": true
  },
  "media_keep_days": 9,
  "max_posts_per_run": 2,
  "posts_per_day": 15,
  "max_age_hours": 12,
  "dedupe_hours": 24,
  "quiet_hours": [
    1,
    7
  ],
  "timezone": "Europe/Paris",
  "hashtags_base": [
    "anime",
    "manga",
    "animefr",
    "actuanime"
  ],
  "sources": [
    {
      "name": "Adala News",
      "url": "https://adala-news.fr/feed/",
      "lang": "fr",
      "include_categories": [
        "anime",
        "manga",
        "manhua",
        "webtoon",
        "manhwa"
      ],
      "exclude_categories": [
        "jeu video",
        "drama",
        "cinema"
      ],
      "exclude_title": [
        "critique",
        "review",
        "planning des animes"
      ]
    },
    {
      "name": "Crunchyroll News",
      "url": "https://cr-news-api-service.prd.crunchyrollsvc.com/v1/fr-FR/rss",
      "lang": "fr",
      "exclude_title": [
        "quiz",
        "sondage",
        "jeu concours",
        "concours"
      ]
    },
    {
      "name": "Animotaku",
      "url": "https://animotaku.fr/feed/",
      "lang": "fr",
      "include_categories": [
        "actualite"
      ],
      "exclude_title": [
        "critique",
        "avis",
        "test",
        "top "
      ]
    }
  ],
  "reels": {
    "mode": "auto",
    "sound": "ambient",
    "max_per_day": 4,
    "music_dir": "assets/music",
    "seconds": 12,
    "manual_timeout_hours": 3
  },
  "fillers": {
    "enabled": true,
    "max_per_run": 1,
    "episode_hours": 30,
    "episode_min_popularity": 15000,
    "anniversary_min_popularity": 100000
  },
  "max_publish_per_run": 2,
  "api_daily_limit": 45,
  "stories_for_fillers": false
}